# Скопируй этот файл в .env и не добавляй .env в git (см. .gitignore)
#
# Как получить значения ниже — см. docs/REVERSE_ENGINEERING.md

HOBOT_DEVICE_ID=your_device_id_here
HOBOT_DEVICE_IP=192.168.1.XXX
HOBOT_LOCAL_KEY=your_local_key_here
HOBOT_PROTOCOL_VERSION=3.3
HOBOT_POLL_INTERVAL=15

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
