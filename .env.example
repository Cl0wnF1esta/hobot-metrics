# Copy this file to .env and don't commit .env to git (see .gitignore)
#
# These variables are only needed for docker-compose.yml (Prometheus + Grafana).
# The exporter's own credentials (devId/IP/localKey) are NOT stored here — they
# are configured separately, directly in router/S99hobot-exporter (if the
# exporter runs on a router or another standalone device, see router/README.md).

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# The address Grafana's port is bound to on the host (VPS). Do NOT use
# 127.0.0.1 — most VPN clients don't route loopback traffic through the
# tunnel (see docs/NETWORK_SETUP.md). This is usually the VPS's own address
# inside the WireGuard tunnel (e.g. 10.x.x.x/32 — the one assigned to the
# wg0 interface on the VPS itself).
GRAFANA_BIND_ADDR=10.0.0.1
