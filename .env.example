# Скопируй этот файл в .env и не добавляй .env в git (см. .gitignore)
#
# Эти переменные нужны только для docker-compose.yml (Prometheus + Grafana).
# Данные самого exporter'а (devId/IP/localKey) сюда НЕ входят — они
# настраиваются отдельно, прямо в S99hobot-exporter (если exporter
# развёрнут на роутере/другом отдельном устройстве, см. router/README.md).

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Адрес, к которому привязывается порт Grafana на хосте (VPS). НЕ используй
# 127.0.0.1 — большинство VPN-клиентов не заворачивают трафик на loopback
# в туннель (см. docs/NETWORK_SETUP.md). Обычно это собственный адрес VPS
# внутри WireGuard-туннеля (например, 10.x.x.x/32 — тот, что назначен
# интерфейсу wg0 на самом VPS).
GRAFANA_BIND_ADDR=10.x.x.x
